# B.E.N. — Basic Electronic Neural-Agent
# ─────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env or keys.txt.

# Google Gemini API key (free tier supported)
# Get one: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API key (enables wake-word + interrupt-word transcription)
# Get one: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
# BEN_DEV_DIR=~/Development          # sandbox root for file tools
# BEN_SYNC_PORT=8767                 # phone-sync HTTP server port
# BEN_NOTCH_IDLE_MS=180000           # notch auto-hide timeout
# BEN_OZONE=x11                      # force XWayland on Wayland (Linux)
# BEN_EDITOR_APP=Visual Studio Code  # preferred editor name
